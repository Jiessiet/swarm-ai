# Set credentials securely in your server shell or secret manager.
# ADAPTION_API_KEY=
ADAPTION_BASE_URL=https://api.prod.adaptionlabs.ai/api/v1
ADAPTION_MODEL=deepseek-v4-flash
AGENT_BACKEND=adaption
AGENT_COUNT=5
ROUNDS=3
REPETITIONS=1
AGENT_TIMEOUT_SECONDS=600
PORT=3333

# Optional task objective for the CLI.
# OBJECTIVE=Study how communication networks shape agent collaboration.

# One catalog model per agent; repeated models are allowed.
# AGENT_MODELS=deepseek-v4-flash,deepseek-v4-flash,deepseek-v4-flash,deepseek-v4-flash,deepseek-v4-flash

# Scripted demo stream pacing (1..250 milliseconds per chunk).
DEMO_STREAM_DELAY_MS=40

# Optional general web search; Crossref scholarly search otherwise needs no key.
# BRAVE_SEARCH_API_KEY=

# Optional local storage overrides.
# ROLE_PRESET_FILE=/absolute/path/role-presets.json
# TRACE_DIR=/absolute/path/traces
