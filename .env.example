# Configure ADAPTION_API_KEY securely in your shell or secret manager.
# ADAPTION_API_KEY=
ADAPTION_BASE_URL=https://api.prod.adaptionlabs.ai/api/v1
# Fallback for the standalone Python experiment; the runner uses per-agent models.
ADAPTION_MODEL=deepseek-v4-flash
AGENT_BACKEND=adaption
ROUNDS=3
STARTING_TOKENS=12
MAX_TAKE=4
# Task selection: shared-resource or shared-fund
TASK=shared-resource
# Shared fund: planted, control, or both (CLI only)
CONDITION=planted
REPETITIONS=1

# Optional comma-separated catalog models, one unique model per agent:
# AGENT_MODELS=deepseek-v4-flash,gemma-4-26b-a4b-it,gemma-4-31b-it,glm-53-flash,qwen3.8-27b
